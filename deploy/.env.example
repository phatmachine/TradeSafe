# Copy to deploy/.env and fill in before `docker compose up`. Never commit the real
# file — it holds your access password and session-signing secret.

# The domain this deployment is reachable at. Caddy automatically provisions and
# renews a TLS certificate for it. Leave as "localhost" only for local testing —
# TradeSafe.md's cookie is Secure-flagged and won't be sent over plain HTTP otherwise.
DOMAIN=tradesafe.example.com

# The single shared password gating the whole app (personal, single-user tool — see
# docs/doctrine-summary.md). Pick something long; there is no rate limiting on the
# login endpoint yet, so a short password is a real weakness on a public host.
TRADESAFE_PASSWORD=change-me-to-something-long-and-random

# Signs the session cookie. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
TRADESAFE_SECRET=change-me-too
